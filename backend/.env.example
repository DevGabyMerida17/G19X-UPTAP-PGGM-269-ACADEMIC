# Copia este archivo como .env y llena los valores.

# --- Base de datos y Redis (con docker compose ya vienen configurados) ---
DATABASE_URL=postgresql+psycopg://onboarding:onboarding@localhost:5432/onboarding
REDIS_URL=redis://localhost:6379/0

# --- Azure OpenAI Service (necesario para el Tutor IA) ---
# Portal de Azure > tu recurso de Azure OpenAI > "Claves y punto de conexión"
AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.openai.azure.com/
AZURE_OPENAI_API_KEY=
# Nombre de la implementación (deployment) del modelo, por ejemplo gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Primera cuenta de Recursos Humanos ---
# Nadie puede registrarse solo: esta cuenta da de alta al resto del personal.
# Si dejas ADMIN_PASSWORD vacío, se le envía un correo para crear su contraseña.
ADMIN_NOMBRE=
ADMIN_CORREO=
ADMIN_PASSWORD=

# --- Correo saliente (invitaciones y "olvidé mi contraseña") ---
# Dirección pública de la página, para los enlaces de los correos
APP_URL=http://localhost:5173
# Con Microsoft 365: smtp.office365.com, puerto 587 y una cuenta con SMTP AUTH habilitado.
# Para pruebas con Docker usa la bandeja Mailpit (http://localhost:8025):
#   SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_STARTTLS=false
# Si SMTP_HOST queda vacío, los correos se guardan en backend/correos_enviados (solo pruebas).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Onboarding PluriOne <no-responder@develop.com.mx>
SMTP_STARTTLS=true

# --- Alternativa a Azure: servicio compatible con OpenAI (se usa solo si Azure está vacío) ---
# Groq (gratis, en la nube):  IA_BASE_URL=https://api.groq.com/openai/v1   IA_MODELO=llama-3.3-70b-versatile
# Ollama (gratis, en tu PC):  IA_BASE_URL=http://localhost:11434/v1        IA_MODELO=qwen2.5:7b  (sin clave)
# OpenAI:                     IA_BASE_URL=https://api.openai.com/v1        IA_MODELO=gpt-4o-mini
IA_BASE_URL=
IA_API_KEY=
IA_MODELO=
# Opcional: low, medium o high. Con modelos que "piensan" (como gemini-3.8-flash), low responde más rápido.
IA_RAZONAMIENTO=

# --- Microsoft Entra ID (opcional: botón "Continuar con Microsoft") ---
# Portal de Azure > Microsoft Entra ID > Registros de aplicaciones
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# --- Otros ---
CARGAR_DATOS_DEMO=true
CORS_ORIGINS=http://localhost:5173
