# Copia este archivo a .env y llena los valores reales.
# .env NUNCA se sube al repositorio (ver .gitignore) — secretos van aquí,
# no en el código (Documento_Arquitectura_Onboarding.docx §8.2).

ENVIRONMENT=development
DEBUG=true

# --- Base de datos ---
DATABASE_URL=postgresql://onboarding:onboarding@localhost:5432/onboarding

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Microsoft Entra ID ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_JWKS_URL=https://login.microsoftonline.com/${ENTRA_TENANT_ID}/discovery/v2.0/keys

# --- JWT de sesión propio ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=cambia-esto-por-un-valor-generado-aleatoriamente
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Azure OpenAI (agentes) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]
